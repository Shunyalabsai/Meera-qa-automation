# Playwright E2E — copy to .env and fill in values

# App URL — either works (root auto-redirects to /vap on staging):
#   https://agents.shunyalabs.ai/
#   https://agents.shunyalabs.ai/vap/
PLAYWRIGHT_BASE_URL=https://agents.shunyalabs.ai/vap/

# Google SSO sign-in (your test account — not committed in .env)
E2E_GOOGLE_EMAIL=you@company.com
E2E_USE_SAVED_AUTH=true

# Optional: dedicated email+password Clerk account for TC-AU-001 / TC-AU-101 / TC-AU-104.
# Google SSO accounts (E2E_GOOGLE_EMAIL) get email OTP after Continue — not a password field.
# E2E_CLERK_EMAIL=e2e-password@yopmail.com
# E2E_CLERK_PASSWORD=YourTestPassword!123
# Optional: 6-digit code if Clerk asks "Check your email" on new device (TC-AU-001)
# E2E_SIGNIN_OTP=123456

# Google Sheets — auto-publish after every test run (see e2e/SHEET-RESULTS.md)
# E2E_SHEET_AUTO_PUBLISH=true
# GOOGLE_RESULTS_SHEET_ID=1QbaJTyhdn1eNIIJkOFbglgyYkpffuN4I2GYUTrhcEvc
# GOOGLE_SERVICE_ACCOUNT_JSON=./secrets/google-service-account.json
# GOOGLE_SHEET_REPO_URL=https://github.com/yamini-pal-singh/Meera-VAP-Yamini
# E2E_SHEET_RUN_JOURNEY=New User
# Optional override when publishing a mixed run: New User | Existing User | Full Suite
