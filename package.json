{
  "name": "meera-vap-e2e",
  "private": true,
  "version": "4.0.0",
  "description": "Playwright E2E tests for Meera Voice Agent Platform",
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:auth": "playwright test e2e/tests/suite/authentication",
    "test:sign-in": "playwright test e2e/tests/suite/authentication/sign-in",
    "test:sign-up": "playwright test e2e/tests/suite/authentication/sign-up --grep-invert @journey",
    "test:build": "playwright test e2e/tests/suite/build",
    "test:run": "playwright test e2e/tests/suite/run",
    "test:analyze": "playwright test e2e/tests/suite/analyze",
    "test:settings": "playwright test e2e/tests/suite/settings",
    "test:agents": "playwright test e2e/tests/suite/build/agents",
    "test:credit-card-payment-reminder": "playwright test e2e/tests/suite/build/agents/credit-card-payment-reminder --grep @credit-card-payment-reminder",
    "test:credit-card-payment-reminder-lifecycle": "playwright test e2e/tests/suite/build/agents/credit-card-payment-reminder/09-lifecycle.spec.ts",
    "test:order-confirmation-reschedule": "playwright test e2e/tests/suite/build/agents/order-confirmation-reschedule --grep @order-confirmation-reschedule",
    "test:order-confirmation-reschedule-lifecycle": "playwright test e2e/tests/suite/build/agents/order-confirmation-reschedule/09-lifecycle.spec.ts",
    "test:appointment-reminder-reschedule": "playwright test e2e/tests/suite/build/agents/appointment-reminder-reschedule --grep @appointment-reminder-reschedule",
    "test:appointment-reminder-reschedule-lifecycle": "playwright test e2e/tests/suite/build/agents/appointment-reminder-reschedule/09-lifecycle.spec.ts",
    "test:retention-call": "playwright test e2e/tests/suite/build/agents/retention-call --grep @retention-call",
    "test:retention-call-lifecycle": "playwright test e2e/tests/suite/build/agents/retention-call/09-lifecycle.spec.ts",
    "test:agents-onboarding": "playwright test e2e/tests/suite/build/agents/onboarding --grep @onboarding",
    "test:prompt-templates": "playwright test e2e/tests/suite/build/prompts --grep @prompts",
    "test:prompt-templates-lifecycle": "playwright test e2e/tests/suite/build/prompts/05-lifecycle.spec.ts",
    "test:playground": "playwright test e2e/tests/suite/build/playground --grep @playground",
    "test:campaigns": "playwright test e2e/tests/suite/run/campaigns --grep @campaigns",
    "test:phone-numbers": "playwright test e2e/tests/suite/run/phone-numbers --grep @phone-numbers",
    "test:live-calls": "playwright test e2e/tests/suite/run/live-calls --grep @live-calls",
    "test:calls": "playwright test e2e/tests/suite/analyze/calls --grep @calls",
    "test:recordings": "playwright test e2e/tests/suite/analyze/recordings --grep @recordings",
    "test:insights": "playwright test e2e/tests/suite/analyze/insights --grep @insights",
    "test:alerts": "playwright test e2e/tests/suite/settings/alerts --grep @alerts",
    "test:billing": "playwright test e2e/tests/suite/settings/billing --grep @billing",
    "test:webhooks": "playwright test e2e/tests/suite/settings/webhooks --grep @webhooks",
    "test:language": "playwright test e2e/tests/suite/global/language --grep @language",
    "test:new-user": "playwright test --grep @new-user",
    "test:existing-user": "playwright test --grep @existing-user",
    "test:cta": "playwright test --grep @cta",
    "test:cta-audit": "playwright test e2e/tests/suite/global/cta-audit.spec.ts",
    "test:start-from-scratch": "playwright test e2e/tests/suite/build/agents/start-from-scratch --grep @start-from-scratch",
    "test:start-from-scratch-lifecycle": "playwright test e2e/tests/suite/build/agents/start-from-scratch/09-lifecycle.spec.ts",
    "test:all-template-journeys": "playwright test e2e/tests/suite/build/agents/credit-card-payment-reminder e2e/tests/suite/build/agents/order-confirmation-reschedule e2e/tests/suite/build/agents/appointment-reminder-reschedule e2e/tests/suite/build/agents/retention-call e2e/tests/suite/build/agents/start-from-scratch --grep @journey",
    "test:agent-templates": "playwright test e2e/tests/suite/build/agents/templates --grep @templates",
    "test:agent-templates-edge": "playwright test e2e/tests/suite/build/agents/templates/edge-cases.spec.ts --grep @edge",
    "test:agents-journey": "playwright test e2e/tests/suite/build/agents/credit-card-payment-reminder --grep @journey",
    "test:global": "playwright test e2e/tests/suite/global",
    "test:ui": "playwright test --ui",
    "test:headed": "playwright test --headed",
    "test:debug": "playwright test --debug",
    "test:positive": "playwright test --grep @positive",
    "test:negative": "playwright test --grep @negative",
    "test:edge": "playwright test --grep @edge",
    "test:cleanup-agents": "E2E_USE_SAVED_AUTH=true E2E_CLEANUP_AGENTS=true E2E_SHEET_AUTO_PUBLISH=false playwright test e2e/tests/suite/qa/cleanup-agents.spec.ts --project=chromium",
    "auth:save": "playwright test e2e/auth.save.setup.ts --project=auth-save --headed",
    "auth:google": "playwright test e2e/auth.save.setup.ts --project=auth-save --headed",
    "auth:verify": "E2E_USE_SAVED_AUTH=true playwright test e2e/auth.setup.ts --project=setup",
    "test:with-auth": "npm run auth:verify && npm test",
    "sheet:catalog": "node e2e/scripts/scan-test-catalog.mjs",
    "sheet:real-catalog": "node e2e/scripts/build-real-catalog.mjs",
    "sheet:export": "node e2e/scripts/export-results-sheet.mjs",
    "sheet:dashboard": "node e2e/scripts/build-dashboard.mjs",
    "sheet:publish": "node e2e/scripts/publish-google-sheet.mjs",
    "sheet:update": "node e2e/scripts/sheet-auto-update.mjs",
    "issues:audit": "node e2e/scripts/audit-known-issues.mjs",
    "report": "playwright show-report",
    "install:browsers": "playwright install chromium",
    "sheet:manual-cases": "node e2e/scripts/fetch-manual-cases.mjs",
    "sheet:uat-fetch": "node e2e/scripts/fetch-uat-cases.mjs",
    "sheet:populate-input": "node e2e/scripts/populate-input-sheet.mjs"
  },
  "devDependencies": {
    "@playwright/test": "^1.52.0",
    "@types/node": "^22.15.0",
    "dotenv": "^16.5.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0"
  }
}
